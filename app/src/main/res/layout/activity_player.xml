<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/player_bg">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/now_playing"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad-Free"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/rounded_bg_dark" />
    </LinearLayout>

    <!-- Embedded Player View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <WebView
            android:id="@+id/youtubeWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />
    </FrameLayout>

    <!-- Speech Info & In-App Media Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvSpeechTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speech Title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSpeakerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speaker Name"
            android:textColor="#B0BEC5"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tvSpeechYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Year"
            android:textColor="@color/accent_light"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tvSpeechDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#90A4AE"
            android:textSize="12sp"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="5dp" />

        <!-- Media Control Bar: Rewind, Play/Pause, Forward -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/control_btn_bg"
                android:src="@drawable/ic_replay_10"
                android:scaleType="centerInside"
                android:contentDescription="Rewind 10s"
                android:elevation="4dp" />

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/play_pause_bg"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"
                android:contentDescription="@string/play"
                android:elevation="8dp" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/control_btn_bg"
                android:src="@drawable/ic_forward_10"
                android:scaleType="centerInside"
                android:contentDescription="Forward 10s"
                android:elevation="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Playing in-app (Ad-Free)"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</LinearLayout>
